NODE_ENV=development

# MongoDB — use a local mongod or a free MongoDB Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017/sprout

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# CORS / client
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Transactional email (Brevo). Leave BREVO_API_KEY blank in dev to skip real sends.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
FROM_EMAIL=sprout@example.com
FROM_NAME=Sprout
# When true (dev only) the server logs verification links instead of failing when email is unavailable.
EMAIL_FAIL_OPEN=true
