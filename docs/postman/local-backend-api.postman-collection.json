      "item": [
        {
          "name": "GET Hello",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /api/hello returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('GET /api/hello returns expected message', function () {",
                  "  pm.expect(responseJson.message).to.eql('Hello World');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
