                  "});",
                  "const devPasswordReset = responseJson?.devPasswordReset || {};",
                  "const setVariable = (name, value) => {",
                  "  if (value === undefined || value === null || value === '') return;",
                  "  pm.collectionVariables.set(name, String(value));",
                  "  pm.variables.set(name, String(value));",
                  "};",
                  "if (devPasswordReset.token) {",
                  "  setVariable('resetToken', devPasswordReset.token);",
                  "  console.log('Reset token saved:', pm.collectionVariables.get('resetToken'));",
                  "}",
                  "if (devPasswordReset.resetUrl) {",
