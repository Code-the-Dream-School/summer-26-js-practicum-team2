    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "const generatedEmail = `test.user+${timestamp}@example.com`;",
                  "pm.collectionVariables.set('testUserEmail', generatedEmail);",
                  "pm.variables.set('testUserEmail', generatedEmail);",
                  "if (!pm.collectionVariables.get('testUserPassword')) {",
                  "  pm.collectionVariables.set('testUserPassword', 'P@ssword123!');",
                  "}",
                  "if (!pm.collectionVariables.get('newTestUserPassword')) {",
                  "  pm.collectionVariables.set('newTestUserPassword', 'N3wP@ssword!');",
                  "}",
                  "pm.variables.set('testUserPassword', pm.collectionVariables.get('testUserPassword'));",
                  "pm.variables.set('newTestUserPassword', pm.collectionVariables.get('newTestUserPassword'));",
                  "console.log('Using generated test email:', generatedEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /register returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Register response confirms success', function () {",
                  "  pm.expect(responseJson.message).to.include('Registration successful');",
                  "});",
                  "pm.test('Register response has user object', function () {",
                  "  pm.expect(responseJson.user).to.be.an('object');",
                  "  pm.expect(responseJson.user.email).to.eql(pm.collectionVariables.get('testUserEmail'));",
                  "});",
                  "const devVerification = responseJson?.devVerification || {};",
                  "const setVariable = (name, value) => {",
                  "  if (value === undefined || value === null || value === '') return;",
                  "  pm.collectionVariables.set(name, String(value));",
                  "  pm.variables.set(name, String(value));",
                  "};",
                  "if (devVerification.token) {",
                  "  setVariable('verificationToken', devVerification.token);",
                  "  console.log('Verification token saved:', pm.collectionVariables.get('verificationToken'));",
                  "}",
                  "if (devVerification.verifyUrl) {",
                  "  setVariable('verificationUrl', devVerification.verifyUrl);",
                  "  console.log('Verification URL saved:', pm.collectionVariables.get('verificationUrl'));",
                  "}",
                  "if (!devVerification.token && !devVerification.verifyUrl) {",
                  "  console.warn('No devVerification data returned. Check the register response body.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"confirmPassword\": \"{{testUserPassword}}\",\n  \"tos\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const fallbackToken = pm.collectionVariables.get('verificationToken') || pm.variables.get('verificationToken') || '';",
                  "if (fallbackToken) {",
                  "  pm.variables.set('verificationToken', fallbackToken);",
                  "  console.log('Using verification token:', fallbackToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /verify returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Verify email response confirms sign-in', function () {",
                  "  pm.expect(responseJson.message).to.eql('Email verified successfully. You are now signed in.');",
                  "});",
                  "pm.test('Verify email response includes csrf token', function () {",
                  "  pm.expect(responseJson.csrfToken).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/verify?token={{verificationToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "{{verificationToken}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Login response confirms success', function () {",
                  "  pm.expect(responseJson.message).to.eql('Login successful!');",
                  "});",
                  "pm.test('Login response includes csrf token', function () {",
                  "  pm.expect(responseJson.csrfToken).to.be.a('string').and.not.empty;",
                  "});",
                  "if (responseJson && responseJson.csrfToken) {",
                  "  pm.collectionVariables.set('csrfToken', responseJson.csrfToken);",
                  "  pm.variables.set('csrfToken', responseJson.csrfToken);",
                  "}",
                  "const setCookieHeaders = pm.response.headers.all().filter((header) => header.key && header.key.toLowerCase() === 'set-cookie');",
                  "if (setCookieHeaders.length) {",
                  "  const cookiePairs = setCookieHeaders",
                  "    .map((header) => header.value || '')",
                  "    .flatMap((value) => value.split(',').map((part) => part.trim()).filter(Boolean))",
                  "    .filter((part) => part.includes('='))",
                  "    .map((part) => part.split(';')[0].trim())",
                  "    .filter(Boolean);",
                  "  const sessionCookie = cookiePairs.find((part) => part.startsWith('session_token=')) || cookiePairs[0] || '';",
                  "  if (sessionCookie) {",
                  "    pm.collectionVariables.set('sessionCookie', sessionCookie);",
                  "    pm.variables.set('sessionCookie', sessionCookie);",
                  "    console.log('Session cookie saved:', sessionCookie);",
                  "  }",
                  "}",
                  "pm.test('Login response captures session cookie', function () {",
                  "  pm.expect(pm.collectionVariables.get('sessionCookie')).to.be.a('string').and.not.empty;",
                  "});",
                  "console.log('CSRF token saved:', responseJson.csrfToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"remember\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const savedCookie = pm.collectionVariables.get('sessionCookie') || pm.variables.get('sessionCookie') || '';",
                  "if (savedCookie) {",
                  "  pm.variables.set('sessionCookie', savedCookie);",
                  "  console.log('Using session cookie:', savedCookie);",
                  "}",
                  "if (!savedCookie) {",
                  "  console.warn('No session cookie is currently stored. Login first to set one.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('First logout returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('First logout confirms success message', function () {",
                  "  pm.expect(responseJson.message).to.eql('Logout successful.');",
                  "});",
                  "pm.collectionVariables.set('sessionCookie', '');",
                  "pm.variables.set('sessionCookie', '');",
                  "console.log('Session cookie cleared after logout.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "logout"]
            }
          },
          "response": []
        },
        {
          "name": "Logout Again (Expect No Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Second logout returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Second logout confirms no authenticated user', function () {",
                  "  pm.expect(responseJson.message).to.eql('No user is authenticated.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "logout"]
            }
          },
          "response": []
        },
