    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();",
                  "const generatedEmail = `test.user+${timestamp}@example.com`;",
                  "pm.collectionVariables.set('testUserEmail', generatedEmail);",
                  "pm.variables.set('testUserEmail', generatedEmail);",
                  "if (!pm.collectionVariables.get('testUserPassword')) {",
                  "  pm.collectionVariables.set('testUserPassword', 'P@ssword123!');",
                  "}",
                  "if (!pm.collectionVariables.get('newTestUserPassword')) {",
                  "  pm.collectionVariables.set('newTestUserPassword', 'N3wP@ssword!');",
                  "}",
                  "pm.variables.set('testUserPassword', pm.collectionVariables.get('testUserPassword'));",
                  "pm.variables.set('newTestUserPassword', pm.collectionVariables.get('newTestUserPassword'));",
                  "console.log('Using generated test email:', generatedEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /register returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Register response confirms success', function () {",
                  "  pm.expect(responseJson.message).to.include('Registration successful');",
                  "});",
                  "pm.test('Register response has user object', function () {",
                  "  pm.expect(responseJson.user).to.be.an('object');",
                  "  pm.expect(responseJson.user.email).to.eql(pm.collectionVariables.get('testUserEmail'));",
                  "});",
                  "if (responseJson?.user?.email) {",
                  "  pm.collectionVariables.set('testUserEmail', responseJson.user.email);",
                  "  pm.variables.set('testUserEmail', responseJson.user.email);",
                  "}",
                  "const devVerification = responseJson?.devVerification || {};",
                  "const setVariable = (name, value) => {",
                  "  if (value === undefined || value === null || value === '') return;",
                  "  pm.collectionVariables.set(name, String(value));",
                  "  pm.variables.set(name, String(value));",
                  "};",
                  "if (devVerification.token) {",
                  "  setVariable('verificationToken', devVerification.token);",
                  "  console.log('Verification token saved:', pm.collectionVariables.get('verificationToken'));",
                  "}",
                  "if (devVerification.verifyUrl) {",
                  "  setVariable('verificationUrl', devVerification.verifyUrl);",
                  "  console.log('Verification URL saved:', pm.collectionVariables.get('verificationUrl'));",
                  "}",
                  "if (!devVerification.token && !devVerification.verifyUrl) {",
                  "  console.warn('No devVerification data returned. Check the register response body.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\",\n  \"confirmPassword\": \"{{testUserPassword}}\",\n  \"tos\": true\n}",
