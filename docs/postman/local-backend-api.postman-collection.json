                "exec": [
                  "const fallbackToken = pm.collectionVariables.get('verificationToken') || pm.variables.get('verificationToken') || '';",
                  "if (fallbackToken) {",
                  "  pm.variables.set('verificationToken', fallbackToken);",
                  "  console.log('Using verification token:', fallbackToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /verify returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Verify email response confirms sign-in', function () {",
                  "  pm.expect(responseJson.message).to.eql('Email verified successfully. You are now signed in.');",
                  "});",
                  "pm.test('Verify email response includes csrf token', function () {",
                  "  pm.expect(responseJson.csrfToken).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/verify?token={{verificationToken}}",
