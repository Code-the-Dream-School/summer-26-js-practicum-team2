        {
          "name": "Reset Password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const fallbackToken = pm.collectionVariables.get('resetToken') || pm.variables.get('resetToken') || '';",
                  "if (fallbackToken) {",
                  "  pm.variables.set('resetToken', fallbackToken);",
                  "  console.log('Using reset token:', fallbackToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /reset-password returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "let responseJson = {};",
                  "try { responseJson = pm.response.json(); } catch (e) { responseJson = {}; }",
                  "pm.test('Reset password confirms success', function () {",
                  "  pm.expect(responseJson.message).to.eql('Password reset successful. You are now signed in.');",
                  "});",
                  "pm.test('Reset password returns signed-in user', function () {",
                  "  pm.expect(responseJson.user).to.be.an('object');",
                  "  pm.expect(responseJson.user.email).to.eql(pm.collectionVariables.get('testUserEmail'));",
                  "});",
                  "pm.collectionVariables.set('testUserPassword', pm.collectionVariables.get('newTestUserPassword'));",
                  "pm.variables.set('testUserPassword', pm.collectionVariables.get('newTestUserPassword'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newTestUserPassword}}\"\n}",
