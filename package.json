{
  "name": "sprout",
  "version": "0.3.5",
  "private": true,
  "description": "Sprout is a full-stack financial literacy platform featuring guided learning paths, interactive quizzes, and progress tracking, built with React, Node.js, and Express.",
  "keywords": [
    "sprout",
    "full-stack",
    "react",
    "vite",
    "nodejs",
    "express",
    "mongodb",
    "jwt-auth",
    "financial-literacy",
    "guided-learning-paths",
    "interactive-lessons",
    "quizzes",
    "progress-dashboard",
    "education",
    "postman",
    "opensource",
    "collaboration",
    "codethedream",
    "practicum"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://github.com/Code-the-Dream-School/summer-26-js-practicum-team2#readme",
  "bugs": {
    "url": "https://github.com/Code-the-Dream-School/summer-26-js-practicum-team2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Code-the-Dream-School/summer-26-js-practicum-team2.git"
  },
  "license": "ISC",
  "author": "DanyloHet,kwishart24,berenicerojas,BytesOfStrength,mnichols08",
  "scripts": {
    "setup": "npm i && npm --prefix backend i && npm --prefix frontend i && ./setup.sh",
    "dev": "dotenv -e .env -- npm-run-all --parallel --race -l development:backend development:frontend",
    "development:backend": "npm --prefix backend run dev",
    "development:frontend": "npm --prefix frontend run dev",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "format": "npm --prefix backend run format && npm --prefix frontend run format",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "playwright test",
    "test": "npm run test:backend && npm run test:frontend",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv-cli": "^11.0.0",
    "npm-run-all": "^4.1.5"
  }
}
