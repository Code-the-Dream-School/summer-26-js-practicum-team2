
# This is the main EditorConfig file for the project.
root = true

# Rules for all files.
[*]

# Use UTF-8 encoding.
charset = utf-8

# Use LF line endings on all operating systems.
end_of_line = lf

# Add a new line at the end of every file.
insert_final_newline = true

# Use spaces instead of tabs.
indent_style = space

# Use 2 spaces for indentation.
indent_size = 2

# Remove unnecessary spaces at the end of lines.
trim_trailing_whitespace = true

[*.md]
# Keep trailing spaces because Markdown may use them for line breaks.
trim_trailing_whitespace = false
