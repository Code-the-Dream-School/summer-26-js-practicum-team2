# VITE_API_BASE_URL is only needed when the frontend is served from a different
# origin than the backend (e.g., production). In local dev, Vite proxies /api → backend.
# VITE_API_BASE_URL=https://sprout-backend.onrender.com
# Backend port that Vite proxies /api to during local dev. Defaults to 8080.
# VITE_API_PORT=8080
